{
  "name": "zig80-lt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev slides.md",
    "build": "slidev build slides.md --base / --without-notes",
    "build:qa": "slidev build media-check.md --base / --out dist-qa",
    "export": "node scripts/export.mjs pdf",
    "thumbnails": "node scripts/export.mjs png",
    "typecheck": "vue-tsc --noEmit",
    "preview": "node scripts/serve.mjs dist 4173",
    "preview:qa": "node scripts/serve.mjs dist-qa 4174",
    "verify": "node scripts/check-content.mjs && node scripts/verify.mjs",
    "package": "node scripts/package.mjs",
    "check:content": "node scripts/check-content.mjs",
    "review:pdf": "node scripts/review-pdf.mjs"
  },
  "dependencies": {
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "latest",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0",
    "playwright-chromium": "^1.56.0",
    "@fontsource-variable/noto-sans-jp": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@types/node": "^24.0.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "image-size": "^2.0.3",
    "floating-vue": "5.2.2"
  }
}
